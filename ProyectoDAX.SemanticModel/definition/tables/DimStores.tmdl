	column 'Tamaño Tienda' =
			SWITCH(
			    TRUE(),
			    DimStores[SellingAreaSize] <= 500 , "Pequeña" ,
			    DimStores[SellingAreaSize] <= 800 , "Mediana" ,
			    DimStores[SellingAreaSize] > 800 , "Grande"
			)
		dataType: string
		lineageTag: 8e598e41-0c17-4288-b10a-e3f9ebc0ba94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimStores = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(Text.TrimEnd(RutaDatos, "\") & "\DimStores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    #"Vacíos a null" = Table.ReplaceValue(#"Encabezados promovidos", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Encabezados promovidos")),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Vacíos a null", {{"StoreKey", Int64.Type}, {"GeographyKey", type number}, {"StoreType", type text}, {"StoreName", type text}, {"EmployeeCount", type number}, {"SellingAreaSize", type number}, {"Store", type text}, {"ContinentName", type text}, {"RegionCountryName", type text}}, "en-US")
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

