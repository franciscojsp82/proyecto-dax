		sourceColumn: ReturnQuantity

		annotation SummarizationSetBy = Automatic

	column Devolucion = IF( NOT FactSales[ReturnQuantity]=0, "Si", "No")
		dataType: string
		lineageTag: e80d4843-8c32-49b4-a5e3-92b9c94d0b39
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo Venta' = IF(FactSales[SalesQuantity]>10, "Mayoreo", "Menudeo")
		dataType: string
		lineageTag: 75accd98-5bf8-443e-a2f1-c8db3e21b808
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo Devolucion' =
			IF(FactSales[ReturnQuantity] = 0,
			BLANK(),
			    IF(FactSales[ReturnQuantity] = 1,
			    "Unica",
			    "Multiple"
			    )
			)
		dataType: string
		lineageTag: d9cd2add-94de-4e72-8813-d486b7314950
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dcto Mayoreo' =
			1 - (IF( FactSales[Tipo Venta] = "Mayoreo" && FactSales[channelKey] = 1 && FactSales[PromotionKey] = 1,
			    0.05,
			    0
			    )
			)
		dataType: double
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ebe5e3c7-ca4b-4da1-935d-3a6c97286d11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition FactSales = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(Text.TrimEnd(RutaDatos, "\") & "\FactSales.parquet")),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen, {{"OrderID", Int64.Type}, {"DateKey", type date}, {"channelKey", Int64.Type}, {"StoreKey", Int64.Type}, {"ProductKey", Int64.Type}, {"PromotionKey", Int64.Type}, {"SalesQuantity", Int64.Type}, {"ReturnQuantity", Int64.Type}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

